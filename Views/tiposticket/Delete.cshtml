@model GestionTickets.tipos_ticket

@{
    ViewBag.Title = "Eliminar Tipo de Ticket";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head vt-panel__head--danger">
            <div class="vt-panel__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <h1 class="vt-panel__title">Eliminar tipo de ticket</h1>
                <p class="vt-panel__hint">Esta acción desactivará la entrada.</p>
            </div>
        </div>

        <div class="vt-panel__body">

            <div class="vt-alert vt-alert--warn">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    ¿Seguro que deseas eliminar este tipo de ticket?
                    <br /><strong>Nota:</strong> el ticket será desactivado, no eliminado definitivamente.
                </div>
            </div>

            <dl class="vt-deflist">
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-calendar-event"></i> Evento</span>
                    <span class="vt-def__val">@(Model.eventos != null ? Model.eventos.nombre : "Sin evento")</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-grid-3x3-gap"></i> Sección</span>
                    <span class="vt-def__val">@(Model.secciones_venue != null ? Model.secciones_venue.nombre : "Sin sección")</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-ticket"></i> Ticket</span>
                    <span class="vt-def__val">@Model.nombre</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-cash-coin"></i> Precio</span>
                    <span class="vt-def__val">@Model.moneda @Model.precio.ToString("N2")</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-box-seam"></i> Cantidad</span>
                    <span class="vt-def__val">@Model.cantidad_ticket</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-toggle-on"></i> Estado</span>
                    <span class="vt-def__val">
                        @if (Model.activo == true)
                        {
                            <span class="vt-status vt-status--on"><i class="bi bi-check-circle-fill"></i> Activo</span>
                        }
                        else
                        {
                            <span class="vt-status vt-status--off"><i class="bi bi-x-circle-fill"></i> Inactivo</span>
                        }
                    </span>
                </div>
            </dl>

            @using (Html.BeginForm("Delete", "TiposTicket", FormMethod.Post, new { id = "formEliminarTipoTicket" }))
            {
                @Html.AntiForgeryToken()
                <div class="vt-form-actions">
                    <a href="@Url.Action("PorEvento", "TiposTicket", new { id = Model.id_evento })" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </a>
                    <button type="button" id="btnEliminarTipoTicket" class="vt-btn vt-btn--danger">
                        <i class="bi bi-slash-circle"></i> Desactivar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#btnEliminarTipoTicket").on("click", function () {
                Swal.fire({
                    title: "¿Desactivar tipo de ticket?",
                    text: "El ticket dejará de estar disponible, pero seguirá guardado en la base de datos.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Sí, desactivar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#d9534f",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $("#formEliminarTipoTicket").submit();
                    }
                });
            });
        });
    </script>
}