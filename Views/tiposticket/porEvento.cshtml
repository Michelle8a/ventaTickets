@model IEnumerable<GestionTickets.tipos_ticket>

@{
    var rol = Session["rol"] as string;
    bool habilitar = rol == "Admin";
    ViewBag.Title = "Tickets del Evento";
}

<div class="vt-page">

    <div class="vt-head">
        <div class="vt-head__titles">
            <span class="vt-eyebrow"><i class="bi bi-ticket-perforated"></i> Entradas</span>
            <h1 class="vt-title">Tickets del evento</h1>
            <p class="vt-subtitle">@(ViewBag.EventoNombre != null ? ViewBag.EventoNombre : "Evento")</p>
        </div>
        <div class="vt-head__actions">
            <a href="@Url.Action("Index", "Eventos")" class="vt-btn vt-btn--ghost">
                <i class="bi bi-arrow-left"></i> Volver a eventos
            </a>
            @if (habilitar)
            {
                <a href="@Url.Action("Create", "TiposTicket", new { idEvento = ViewBag.IdEvento })" class="vt-btn vt-btn--primary">
                    <i class="bi bi-plus-lg"></i> Crear ticket
                </a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="vt-empty">
            <i class="bi bi-ticket"></i>
            <h3>Sin tickets todavía</h3>
            <p>Este evento aún no tiene tipos de ticket registrados.</p>
        </div>
    }
    else
    {
        <div class="vt-grid">
            @foreach (var ticket in Model)
            {
                <article class="vt-card vt-ticket">
                    <div class="vt-ticket__head">
                        <h2 class="vt-ticket__name">@ticket.nombre</h2>
                        <span class="vt-status vt-status--light"><i class="bi bi-grid-3x3-gap"></i> @(ticket.secciones_venue != null ? ticket.secciones_venue.nombre : "General")</span>
                    </div>

                    <div class="vt-price">
                        <span class="vt-price__cur">@ticket.moneda</span>
                        <span class="vt-price__amount">@ticket.precio.ToString("N2")</span>
                    </div>

                    <hr class="vt-divider" />

                    <div class="vt-card__body" style="padding-top:0;">
                        <ul class="vt-meta">
                            <li><i class="bi bi-box-seam"></i> <span class="vt-meta__label">Disponibles:</span> <span>@ticket.cantidad_ticket</span></li>
                            <li><i class="bi bi-play-circle"></i> <span class="vt-meta__label">Inicio:</span> <span>@(ticket.venta_inicio.HasValue ? ticket.venta_inicio.Value.ToString("dd/MM/yyyy HH:mm") : "-")</span></li>
                            <li><i class="bi bi-stop-circle"></i> <span class="vt-meta__label">Fin:</span> <span>@(ticket.venta_fin.HasValue ? ticket.venta_fin.Value.ToString("dd/MM/yyyy HH:mm") : "-")</span></li>
                        </ul>
                    </div>

                    <div class="vt-card__footer">
                        <a href="@Url.Action("Create", "Compra", new { idTipoTicket = ticket.id_tipo_ticket })"
                           class="vt-btn vt-btn--accent vt-btn--sm">
                            <i class="bi bi-cart-plus"></i> Comprar
                        </a>
                        <a href="@Url.Action("Details", "TiposTicket", new { id = ticket.id_tipo_ticket })" class="vt-btn vt-btn--ghost vt-btn--sm">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        @if (habilitar)
                        {
                            <a href="@Url.Action("Edit", "TiposTicket", new { id = ticket.id_tipo_ticket })" class="vt-btn vt-btn--gold vt-btn--sm">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", "TiposTicket", new { id = ticket.id_tipo_ticket })" class="vt-btn vt-btn--danger vt-btn--sm">
                                <i class="bi bi-trash3"></i> Eliminar
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: "Operación realizada",
                    text: "@TempData["SuccessMessage"]",
                    icon: "success",
                    confirmButtonText: "Aceptar",
                    confirmButtonColor: "#1B3C53"
                });
                </text>
            }
        });
    </script>
}