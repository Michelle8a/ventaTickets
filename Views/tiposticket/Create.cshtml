@model GestionTickets.tipos_ticket

@{
    ViewBag.Title = "Crear Tipo de Ticket";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head">
            <div class="vt-panel__icon"><i class="bi bi-ticket-perforated"></i></div>
            <div>
                <h1 class="vt-panel__title">Crear tipo de ticket</h1>
                <p class="vt-panel__hint">Define una nueva entrada para el evento.</p>
            </div>
        </div>

        <div class="vt-panel__body">
            @using (Html.BeginForm("Create", "TiposTicket", FormMethod.Post, new { id = "formCrearTipoTicket" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="vt-field">
                    <label class="vt-label">Evento</label>
                    @Html.DropDownList("id_evento", null, "Seleccione un evento", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.id_evento, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Sección</label>
                    @Html.DropDownList("id_seccion", null, "Seleccione una sección", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.id_seccion, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Nombre del ticket</label>
                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control", placeholder = "General, VIP, Preferente..." })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="vt-row">
                    <div class="vt-field">
                        <label class="vt-label">Precio</label>
                        @Html.TextBoxFor(model => model.precio, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
                        @Html.ValidationMessageFor(model => model.precio, "", new { @class = "text-danger" })
                    </div>
                    <div class="vt-field">
                        <label class="vt-label">Moneda</label>
                        @Html.TextBoxFor(model => model.moneda, new { @class = "form-control", placeholder = "USD", Value = "USD" })
                        @Html.ValidationMessageFor(model => model.moneda, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="vt-field">
                    <label class="vt-label">Cantidad de tickets</label>
                    @Html.TextBoxFor(model => model.cantidad_ticket, new { @class = "form-control", type = "number", min = "1" })
                    @Html.ValidationMessageFor(model => model.cantidad_ticket, "", new { @class = "text-danger" })
                </div>

                <div class="vt-row">
                    <div class="vt-field">
                        <label class="vt-label">Inicio de venta</label>
                        @Html.TextBoxFor(model => model.venta_inicio, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        @Html.ValidationMessageFor(model => model.venta_inicio, "", new { @class = "text-danger" })
                    </div>
                    <div class="vt-field">
                        <label class="vt-label">Fin de venta</label>
                        @Html.TextBoxFor(model => model.venta_fin, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        @Html.ValidationMessageFor(model => model.venta_fin, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="vt-check">
                    @Html.CheckBox("activo", true)
                    <label for="activo">Ticket activo</label>
                    @Html.ValidationMessageFor(model => model.activo, "", new { @class = "text-danger d-block" })
                </div>

                <div class="vt-form-actions">
                    <a href="@Url.Action("Index", "Eventos")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                    <button type="button" id="btnCrearTipoTicket" class="vt-btn vt-btn--primary">
                        <i class="bi bi-check-lg"></i> Guardar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#btnCrearTipoTicket").on("click", function () {
                Swal.fire({
                    title: "¿Crear tipo de ticket?",
                    text: "Se guardará el nuevo tipo de ticket para el evento seleccionado.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Sí, guardar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#1B3C53",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $("#formCrearTipoTicket").submit();
                    }
                });
            });
        });
    </script>
}