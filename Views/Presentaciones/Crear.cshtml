@{ ViewBag.Title = "Nueva Presentación"; }

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head">
            <div class="vt-panel__icon"><i class="bi bi-camera-video-fill"></i></div>
            <div>
                <h1 class="vt-panel__title">Nueva presentación</h1>
                <p class="vt-panel__hint">Completa la información para registrar una nueva presentación.</p>
            </div>
        </div>

        <div class="vt-panel__body">
            @using (Html.BeginForm("Crear", "Presentaciones", FormMethod.Post))
            {
                <div class="vt-field">
                    <label class="vt-label">Evento</label>
                    <select name="id_evento" class="form-control" required>
                        <option value="">-- Selecciona un evento --</option>
                        @foreach (var e in ViewBag.Eventos)
                        {
                            <option value="@e.id_evento">@e.evento</option>
                        }
                    </select>
                </div>

                <div class="vt-field">
                    <label class="vt-label">Artista</label>
                    <select name="id_artista" class="form-control" required>
                        <option value="">-- Selecciona un artista --</option>
                        @foreach (var a in ViewBag.Artistas)
                        {
                            <option value="@a.id_artista">@a.nombre</option>
                        }
                    </select>
                </div>

                <div class="vt-field">
                    <label class="vt-label">Escenario</label>
                    <input type="text" name="escenario" class="form-control" placeholder="Ej. Escenario principal" />
                </div>

                <div class="vt-row">
                    <div class="vt-field">
                        <label class="vt-label">Fecha y hora inicio</label>
                        <input type="datetime-local" name="fecha_hora_inicio" class="form-control" required />
                    </div>
                    <div class="vt-field">
                        <label class="vt-label">Fecha y hora fin</label>
                        <input type="datetime-local" name="fecha_hora_fin" class="form-control" />
                    </div>
                </div>

                <div class="vt-field">
                    <label class="vt-label">Orden</label>
                    <input type="number" name="orden" class="form-control" placeholder="Ej. 1" />
                </div>

                <div class="vt-form-actions">
                    <a href="@Url.Action("Index")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="vt-btn vt-btn--primary">
                        <i class="bi bi-check-lg"></i> Guardar
                    </button>
                </div>
            }
        </div>
    </div>
</div>