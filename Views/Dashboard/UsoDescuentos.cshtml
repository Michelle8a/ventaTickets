@model GestionTickets.Models.UsoDescuentosViewModel
@{
    ViewBag.Title = "Uso de Descuentos";
}

<style>
    body { background-color: #f4f6f9; }
    .kpi-card  { border:none; border-radius:16px; background:white; box-shadow:0 4px 15px rgba(0,0,0,0.08); }
    .table-card{ border:none; border-radius:16px; background:white; box-shadow:0 4px 15px rgba(0,0,0,0.08); }
</style>

<div class="container py-5">

    <div class="d-flex align-items-center mb-4">
        <a href="@Url.Action("ReporteOrganizador","Dashboard")" class="btn btn-outline-secondary me-3">← Volver</a>
        <div>
            <h2 class="fw-bold mb-0">🏷 Uso de Descuentos</h2>
            <p class="text-muted mb-0">Compras que utilizaron algún código de descuento</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="kpi-card p-4 text-center">
                <div style="font-size:28px; font-weight:bold; color:#111;">@Model.TotalConDescuento</div>
                <div class="text-muted">Compras con Descuento</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="kpi-card p-4 text-center">
                <div style="font-size:28px; font-weight:bold; color:#f59e0b;">@Model.TotalTicketsDesc</div>
                <div class="text-muted">Tickets con Descuento</div>
            </div>
        </div>
    </div>

    <div class="table-card p-4">
        <h5 class="fw-bold mb-3">Uso por Descuento</h5>
        @if (Model.PorDescuento != null && Model.PorDescuento.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID Descuento</th>
                            <th>Usos</th>
                            <th>Tickets Vendidos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.PorDescuento.OrderByDescending(x => x.Usos))
                        {
                            <tr>
                                <td>#@d.IdDescuento</td>
                                <td class="fw-semibold">@d.Usos</td>
                                <td>@d.Tickets</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <div style="font-size:50px;">🏷</div>
                <p class="text-muted mt-2">No hay compras con descuento registradas.</p>
            </div>
        }
    </div>

</div>
