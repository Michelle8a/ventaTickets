@model IEnumerable<GestionTickets.usuarios>
@{
    ViewBag.Title = "Usuarios";
}

<div class="vt-page">
    <div class="vt-head">
        <div class="vt-head__titles">
            <span class="vt-eyebrow"><i class="bi bi-people"></i> Administración</span>
            <h1 class="vt-title">Usuarios</h1>
            <p class="vt-subtitle">Gestiona los usuarios registrados en el sistema.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="vt-empty">
            <i class="bi bi-people"></i>
            <h3>No hay usuarios registrados</h3>
            <p>Los usuarios aparecerán aquí cuando se registren.</p>
        </div>
    }
    else
    {
        <div class="vt-grid">
            @foreach (var u in Model)
            {
                var rolUsuario = u.usuarios_rol.FirstOrDefault();
                var nombreRol = rolUsuario?.roles?.nombre ?? "Sin rol";

                <article class="vt-card">
                    <div class="vt-card__media">
                        @if (u.activo == true)
                        {
                            <span class="vt-status vt-status--light"><i class="bi bi-circle-fill" style="font-size:.55em;"></i> Activo</span>
                        }
                        else
                        {
                            <span class="vt-status vt-status--off"><i class="bi bi-circle-fill" style="font-size:.55em;"></i> Inactivo</span>
                        }
                        <span class="vt-chip"><i class="bi bi-shield"></i> @nombreRol</span>
                        <i class="bi bi-person-circle vt-card__media-icon"></i>
                    </div>
                    <div class="vt-card__body">
                        <h2 class="vt-card__title">@u.nombre @u.apellido</h2>
                        <p class="vt-card__type">@u.email</p>
                        <ul class="vt-meta">
                            <li><i class="bi bi-telephone"></i> <span>@(string.IsNullOrWhiteSpace(u.telefono) ? "Sin teléfono" : u.telefono)</span></li>
                            <li><i class="bi bi-globe"></i> <span>@(u.paises != null ? u.paises.nombre : "Sin país")</span></li>
                            <li><i class="bi bi-calendar3"></i> <span>@(u.fecha_registro.HasValue ? u.fecha_registro.Value.ToString("dd/MM/yyyy") : "-")</span></li>
                        </ul>
                    </div>
                    <div class="vt-card__footer">
                        <a href="@Url.Action("Details", new { id = u.id_usuario })" class="vt-btn vt-btn--ghost vt-btn--sm">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        <a href="@Url.Action("Edit", new { id = u.id_usuario })" class="vt-btn vt-btn--gold vt-btn--sm">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a href="@Url.Action("Delete", new { id = u.id_usuario })" class="vt-btn vt-btn--danger vt-btn--sm">
                            <i class="bi bi-trash3"></i> Eliminar
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</div>