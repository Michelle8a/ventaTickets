@model GestionTickets.usuarios
@{
    ViewBag.Title = "Eliminar Usuario";
    var rolUsuario = Model.usuarios_rol.FirstOrDefault();
    var nombreRol = rolUsuario?.roles?.nombre ?? "Sin rol";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head vt-panel__head--danger">
            <div class="vt-panel__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <h1 class="vt-panel__title">Eliminar usuario</h1>
                <p class="vt-panel__hint">Esta acción desactivará al usuario.</p>
            </div>
        </div>
        <div class="vt-panel__body">
            <div class="vt-alert vt-alert--warn">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    ¿Seguro que deseas eliminar este usuario?
                    <br /><strong>Nota:</strong> el usuario será desactivado, no eliminado definitivamente.
                </div>
            </div>
            <dl class="vt-deflist">
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-person"></i> Nombre</span>
                    <span class="vt-def__val">@Model.nombre @Model.apellido</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-envelope"></i> Email</span>
                    <span class="vt-def__val">@Model.email</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-shield"></i> Rol</span>
                    <span class="vt-def__val">@nombreRol</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-globe"></i> País</span>
                    <span class="vt-def__val">@(Model.paises != null ? Model.paises.nombre : "Sin país")</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-toggle-on"></i> Estado</span>
                    <span class="vt-def__val">
                        @if (Model.activo == true)
                        {
                            <span class="vt-status vt-status--on"><i class="bi bi-check-circle-fill"></i> Activo</span>
                        }
                        else
                        {
                            <span class="vt-status vt-status--off"><i class="bi bi-x-circle-fill"></i> Inactivo</span>
                        }
                    </span>
                </div>
            </dl>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="vt-form-actions">
                    <a href="@Url.Action("Index")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </a>
                    <button type="submit" class="vt-btn vt-btn--danger">
                        <i class="bi bi-trash3"></i> Eliminar
                    </button>
                </div>
            }
        </div>
    </div>
</div>