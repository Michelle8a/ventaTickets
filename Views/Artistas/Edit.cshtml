@model GestionTickets.artistas

@{
    ViewBag.Title = "Editar Artista";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head">
            <div class="vt-panel__icon"><i class="bi bi-pencil-square"></i></div>
            <div>
                <h1 class="vt-panel__title">Editar artista</h1>
                <p class="vt-panel__hint">Actualiza la información del artista.</p>
            </div>
        </div>

        <div class="vt-panel__body">
            @using (Html.BeginForm("Edit", "Artistas", FormMethod.Post, new { id = "formEditarArtista" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.id_artista)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="vt-field">
                    <label class="vt-label">Nombre del artista</label>
                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Género</label>
                    @Html.TextBoxFor(model => model.genero, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.genero, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Descripción</label>
                    @Html.TextAreaFor(model => model.descripcion, new { @class = "form-control", rows = 4 })
                    @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">URL de imagen</label>
                    @Html.TextBoxFor(model => model.imagen_url, new { @class = "form-control", placeholder = "https://..." })
                    @Html.ValidationMessageFor(model => model.imagen_url, "", new { @class = "text-danger" })
                </div>

                if (!string.IsNullOrWhiteSpace(Model.imagen_url))
                {
                    <div class="vt-field">
                        <label class="vt-label">Vista previa</label>
                        <img src="@Model.imagen_url" alt="@Model.nombre" class="vt-detail-img" style="max-height:220px;" />
                    </div>
                }

                <div class="vt-check">
                    @Html.CheckBox("activo", Model.activo == true)
                    <label for="activo">Artista activo</label>
                    @Html.ValidationMessageFor(model => model.activo, "", new { @class = "text-danger d-block" })
                </div>

                <div class="vt-form-actions">
                    <a href="@Url.Action("Index", "Artistas")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                    <button type="button" id="btnEditarArtista" class="vt-btn vt-btn--primary">
                        <i class="bi bi-check-lg"></i> Guardar cambios
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#btnEditarArtista").on("click", function () {
                Swal.fire({
                    title: "¿Guardar cambios?",
                    text: "Se actualizará la información del artista.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Sí, guardar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#1B3C53",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $("#formEditarArtista").submit();
                    }
                });
            });
        });
    </script>
}