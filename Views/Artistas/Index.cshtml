@model IEnumerable<GestionTickets.artistas>

@{
    var rol = Session["rol"] as string;
    bool habilitar = rol == "Admin" || rol == "Organizador";
    ViewBag.Title = "Artistas";
}

<div class="vt-page">

    <div class="vt-head">
        <div class="vt-head__titles">
            <span class="vt-eyebrow"><i class="bi bi-stars"></i> Talento</span>
            <h1 class="vt-title">Artistas</h1>
            <p class="vt-subtitle">Conoce a los artistas y grupos que dan vida a los eventos.</p>
        </div>
        @if (habilitar)
        {
            <div class="vt-head__actions">
                <a href="@Url.Action("Create", "Artistas")" class="vt-btn vt-btn--primary">
                    <i class="bi bi-plus-lg"></i> Crear artista
                </a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="vt-empty">
            <i class="bi bi-person-bounding-box"></i>
            <h3>No hay artistas registrados</h3>
            <p>Cuando agregues artistas aparecerán aquí.</p>
        </div>
    }
    else
    {
        <div class="vt-grid">
            @foreach (var artista in Model)
            {
                var descripcion = artista.descripcion;
                if (!string.IsNullOrWhiteSpace(descripcion) && descripcion.Length > 110)
                {
                    descripcion = descripcion.Substring(0, 110) + "...";
                }

                <article class="vt-card">
                    <div class="vt-card__media vt-card__media--photo"
                         style="@(string.IsNullOrWhiteSpace(artista.imagen_url) ? "" : $"background-image:url('{artista.imagen_url}')")">
                        @if (!string.IsNullOrWhiteSpace(artista.genero))
                        {
                            <span class="vt-chip"><i class="bi bi-music-note"></i> @artista.genero</span>
                        }
                        @if (artista.activo == true)
                        {
                            <span class="vt-status vt-status--light"><i class="bi bi-circle-fill" style="font-size:.55em;"></i> Activo</span>
                        }
                        @if (string.IsNullOrWhiteSpace(artista.imagen_url))
                        {
                            <span class="vt-media-empty"><i class="bi bi-person-fill"></i></span>
                        }
                    </div>

                    <div class="vt-card__body">
                        <h2 class="vt-card__title">@artista.nombre</h2>
                        <p class="vt-card__type">@(string.IsNullOrWhiteSpace(descripcion) ? "Sin descripción." : descripcion)</p>
                    </div>

                    <div class="vt-card__footer">
                        <a href="@Url.Action("Details", "Artistas", new { id = artista.id_artista })" class="vt-btn vt-btn--accent vt-btn--sm">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        @if (habilitar)
                        {
                            <a href="@Url.Action("Edit", "Artistas", new { id = artista.id_artista })" class="vt-btn vt-btn--gold vt-btn--sm btn-editar-artista">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", "Artistas", new { id = artista.id_artista })" class="vt-btn vt-btn--danger vt-btn--sm btn-eliminar-artista">
                                <i class="bi bi-trash3"></i> Eliminar
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: "Operación realizada",
                    text: "@TempData["SuccessMessage"]",
                    icon: "success",
                    confirmButtonText: "Aceptar",
                    confirmButtonColor: "#1B3C53"
                });
                </text>
            }

            $(".btn-editar-artista").on("click", function (e) {
                e.preventDefault();
                var url = $(this).attr("href");
                Swal.fire({
                    title: "¿Editar artista?",
                    text: "Serás redirigido al formulario de edición.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Sí, editar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#e6a23c",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });

            $(".btn-eliminar-artista").on("click", function (e) {
                e.preventDefault();
                var url = $(this).attr("href");
                Swal.fire({
                    title: "¿Eliminar artista?",
                    text: "Primero revisarás los datos del artista antes de confirmar.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Continuar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#d9534f",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });

        });
    </script>
}