@model GestionTickets.artistas

@{
    ViewBag.Title = "Crear Artista";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head">
            <div class="vt-panel__icon"><i class="bi bi-person-plus"></i></div>
            <div>
                <h1 class="vt-panel__title">Crear artista</h1>
                <p class="vt-panel__hint">Registra un nuevo artista o grupo.</p>
            </div>
        </div>

        <div class="vt-panel__body">
            @using (Html.BeginForm("Create", "Artistas", FormMethod.Post, new { id = "formCrearArtista" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="vt-field">
                    <label class="vt-label">Nombre del artista</label>
                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control", placeholder = "Nombre del artista o grupo" })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Género</label>
                    @Html.TextBoxFor(model => model.genero, new { @class = "form-control", placeholder = "Rock, Pop, Electrónica, Teatro..." })
                    @Html.ValidationMessageFor(model => model.genero, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Descripción</label>
                    @Html.TextAreaFor(model => model.descripcion, new { @class = "form-control", rows = 4, placeholder = "Breve descripción del artista" })
                    @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">URL de imagen</label>
                    @Html.TextBoxFor(model => model.imagen_url, new { @class = "form-control", placeholder = "https://..." })
                    @Html.ValidationMessageFor(model => model.imagen_url, "", new { @class = "text-danger" })
                </div>

                <div class="vt-check">
                    @Html.CheckBox("activo", true)
                    <label for="activo">Artista activo</label>
                    @Html.ValidationMessageFor(model => model.activo, "", new { @class = "text-danger d-block" })
                </div>

                <div class="vt-form-actions">
                    <a href="@Url.Action("Index", "Artistas")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                    <button type="button" id="btnCrearArtista" class="vt-btn vt-btn--primary">
                        <i class="bi bi-check-lg"></i> Guardar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#btnCrearArtista").on("click", function () {
                Swal.fire({
                    title: "¿Crear artista?",
                    text: "Se guardará el nuevo artista.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Sí, guardar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#1B3C53",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $("#formCrearArtista").submit();
                    }
                });
            });
        });
    </script>
}