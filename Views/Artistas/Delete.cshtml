@model GestionTickets.artistas

@{
    ViewBag.Title = "Eliminar Artista";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head vt-panel__head--danger">
            <div class="vt-panel__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <h1 class="vt-panel__title">Eliminar artista</h1>
                <p class="vt-panel__hint">Esta acción desactivará el artista.</p>
            </div>
        </div>

        <div class="vt-panel__body">

            <div class="vt-alert vt-alert--warn">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    ¿Seguro que deseas eliminar este artista?
                    <br /><strong>Nota:</strong> el artista será desactivado, no eliminado definitivamente.
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.imagen_url))
            {
                <img src="@Model.imagen_url" alt="@Model.nombre" class="vt-detail-img" />
            }

            <dl class="vt-deflist">
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-person"></i> Nombre</span>
                    <span class="vt-def__val">@Model.nombre</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-music-note"></i> Género</span>
                    <span class="vt-def__val">@(string.IsNullOrWhiteSpace(Model.genero) ? "No especificado" : Model.genero)</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-card-text"></i> Descripción</span>
                    <span class="vt-def__val">@(string.IsNullOrWhiteSpace(Model.descripcion) ? "Sin descripción" : Model.descripcion)</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-toggle-on"></i> Estado</span>
                    <span class="vt-def__val">
                        @if (Model.activo == true)
                        {
                            <span class="vt-status vt-status--on"><i class="bi bi-check-circle-fill"></i> Activo</span>
                        }
                        else
                        {
                            <span class="vt-status vt-status--off"><i class="bi bi-x-circle-fill"></i> Inactivo</span>
                        }
                    </span>
                </div>
            </dl>

            @using (Html.BeginForm("Delete", "Artistas", FormMethod.Post, new { id = "formEliminarArtista" }))
            {
                @Html.AntiForgeryToken()
                <div class="vt-form-actions">
                    <a href="@Url.Action("Index", "Artistas")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </a>
                    <button type="button" id="btnEliminarArtista" class="vt-btn vt-btn--danger">
                        <i class="bi bi-slash-circle"></i> Desactivar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#btnEliminarArtista").on("click", function () {
                Swal.fire({
                    title: "¿Desactivar artista?",
                    text: "El artista dejará de aparecer en el catálogo activo.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Sí, desactivar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#d9534f",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $("#formEliminarArtista").submit();
                    }
                });
            });
        });
    </script>
}