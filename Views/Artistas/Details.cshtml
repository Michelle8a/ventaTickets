@model GestionTickets.artistas

@{
    var rol = Session["rol"] as string;
    bool habilitar = rol == "Admin" || rol == "Organizador";
    ViewBag.Title = "Detalle Artista";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head vt-panel__head--info">
            <div class="vt-panel__icon"><i class="bi bi-person-badge"></i></div>
            <div>
                <h1 class="vt-panel__title">@Model.nombre</h1>
                <p class="vt-panel__hint">@(string.IsNullOrWhiteSpace(Model.genero) ? "Artista" : Model.genero)</p>
            </div>
        </div>

        <div class="vt-panel__body">

            @if (!string.IsNullOrWhiteSpace(Model.imagen_url))
            {
                <img src="@Model.imagen_url" alt="@Model.nombre" class="vt-detail-img" />
            }

            @if (!string.IsNullOrWhiteSpace(Model.descripcion))
            {
                <p style="color:var(--vt-text); line-height:1.55; margin-bottom:1.3rem;">@Model.descripcion</p>
            }

            <dl class="vt-deflist">
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-person"></i> Nombre</span>
                    <span class="vt-def__val">@Model.nombre</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-music-note"></i> Género</span>
                    <span class="vt-def__val">@(string.IsNullOrWhiteSpace(Model.genero) ? "No especificado" : Model.genero)</span>
                </div>
                <div class="vt-def">
                    <span class="vt-def__key"><i class="bi bi-toggle-on"></i> Estado</span>
                    <span class="vt-def__val">
                        @if (Model.activo == true)
                        {
                            <span class="vt-status vt-status--on"><i class="bi bi-check-circle-fill"></i> Activo</span>
                        }
                        else
                        {
                            <span class="vt-status vt-status--off"><i class="bi bi-x-circle-fill"></i> Inactivo</span>
                        }
                    </span>
                </div>
            </dl>

            <div class="vt-form-actions">
                <a href="@Url.Action("Index", "Artistas")" class="vt-btn vt-btn--ghost">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
                @if (habilitar)
                {
                    <a href="@Url.Action("Edit", "Artistas", new { id = Model.id_artista })" class="vt-btn vt-btn--gold">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                }
            </div>

        </div>
    </div>
</div>