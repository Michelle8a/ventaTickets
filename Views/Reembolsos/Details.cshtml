@model GestionTickets.Models.Reembolso
@{
    ViewBag.Title = "Detalle del Reembolso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">

                    @{
                        bool completado = Model.Estado == "completado";
                    }

                    <div class="display-4 mb-3 @(completado ? "text-success" : "text-warning")">
                        <i class="fa-solid @(completado ? "fa-circle-check" : "fa-clock")"></i>
                    </div>
                    <h4 class="mb-1">
                        @(completado ? "Reembolso procesado" : "Reembolso pendiente")
                    </h4>
                    <p class="text-muted mb-4">
                        Solicitud #@Model.IdReembolso
                        &nbsp;·&nbsp;@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <div class="text-start small">

                        @if (Model.Compra != null)
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Código de orden</div>
                                <div class="col-7 fw-semibold">@Model.Compra.CodigoOrden</div>
                            </div>
                        }

                        @if (Model.Pago != null)
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Método de pago original</div>
                                <div class="col-7">
                                    @(Model.Pago.Metodo == "card" ? "Tarjeta (Stripe)" : "Efectivo")
                                </div>
                            </div>
                        }

                        <div class="row mb-2">
                            <div class="col-5 text-muted">Monto reembolsado</div>
                            <div class="col-7 fw-bold text-success fs-5">$@Model.Monto.ToString("0.00")</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 text-muted">Motivo</div>
                            <div class="col-7">@Model.Motivo</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 text-muted">Estado</div>
                            <div class="col-7">
                                @{
                                    var badge = Model.Estado == "completado" ? "bg-success"
                                              : Model.Estado == "pendiente"  ? "bg-warning text-dark"
                                              : "bg-secondary";
                                }
                                <span class="badge @badge">@Model.Estado.ToUpper()</span>
                            </div>
                        </div>

                        @if (Model.FechaProceso.HasValue)
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Procesado el</div>
                                <div class="col-7">@Model.FechaProceso.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.StripeRefundId))
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">ID Stripe Refund</div>
                                <div class="col-7 text-break"><code class="small">@Model.StripeRefundId</code></div>
                            </div>
                        }

                    </div>

                    <div class="d-flex gap-2 justify-content-center mt-4">
                        @Html.ActionLink("Ver historial de reembolsos", "Index", "Reembolsos",
                            null, new { @class = "btn btn-outline-secondary" })
                        @Html.ActionLink("Volver al inicio", "Index", "Home",
                            null, new { @class = "btn btn-primary" })
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
