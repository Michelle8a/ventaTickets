@model GestionTickets.eventos

@{
    ViewBag.Title = "Crear Evento";
}

<div class="vt-panel-wrap">
    <div class="vt-panel">
        <div class="vt-panel__head">
            <div class="vt-panel__icon"><i class="bi bi-calendar-plus"></i></div>
            <div>
                <h1 class="vt-panel__title">Crear evento</h1>
                <p class="vt-panel__hint">Completa la información para publicar un nuevo evento.</p>
            </div>
        </div>

        <div class="vt-panel__body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="vt-field">
                    <label class="vt-label">Venue</label>
                    @Html.DropDownList("id_venue", null, "Seleccione un venue", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.id_venue, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Categoría</label>
                    @Html.DropDownList("id_categoria", null, "Seleccione una categoría", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.id_categoria, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Usuario creador</label>
                    @Html.DropDownList("id_usuario", null, "Seleccione un usuario", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.id_usuario, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Nombre del evento</label>
                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control", placeholder = "Ej. Concierto de Aniversario" })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Tipo</label>
                    @Html.TextBoxFor(model => model.tipo, new { @class = "form-control", placeholder = "Concierto, Teatro, Festival, Conferencia..." })
                    @Html.ValidationMessageFor(model => model.tipo, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">Descripción</label>
                    @Html.TextAreaFor(model => model.descripcion, new { @class = "form-control", rows = 4, placeholder = "Describe el evento..." })
                    @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="vt-field">
                    <label class="vt-label">URL de imagen</label>
                    @Html.TextBoxFor(model => model.imagen_url, new { @class = "form-control", placeholder = "https://..." })
                    @Html.ValidationMessageFor(model => model.imagen_url, "", new { @class = "text-danger" })
                </div>

                <div class="vt-row">
                    <div class="vt-field">
                        <label class="vt-label">Fecha inicio</label>
                        @Html.TextBoxFor(model => model.fecha_inicio, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.fecha_inicio, "", new { @class = "text-danger" })
                    </div>
                    <div class="vt-field">
                        <label class="vt-label">Fecha fin</label>
                        @Html.TextBoxFor(model => model.fecha_fin, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.fecha_fin, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="vt-check">
                    @Html.CheckBox("activo", true)
                    <label for="activo">Evento activo</label>
                    @Html.ValidationMessageFor(model => model.activo, "", new { @class = "text-danger d-block" })
                </div>

                <div class="vt-form-actions">
                    <a href="@Url.Action("Index", "Eventos")" class="vt-btn vt-btn--ghost">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                    <button type="submit" class="vt-btn vt-btn--primary">
                        <i class="bi bi-check-lg"></i> Guardar evento
                    </button>
                </div>
            }
        </div>
    </div>
</div>