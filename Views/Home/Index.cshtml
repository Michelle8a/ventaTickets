@{
    var usuario = Session["usuario"] as GestionTickets.usuarios;
    ViewBag.Title = "Inicio";
}

<div class="vt-page">
    <div class="vt-head">
        <div class="vt-head__titles">
            <span class="vt-eyebrow"><i class="bi bi-house-heart"></i> Bienvenido</span>
            <h1 class="vt-title">GestionTickets</h1>
            <p class="vt-subtitle">Compra y gestiona tickets para eventos en toda Centroamérica.</p>
        </div>
        <div class="vt-head__actions">
            <a href="/Eventos" class="vt-btn vt-btn--primary">
                <i class="bi bi-calendar-event"></i> Ver eventos
            </a>
            @if (usuario == null)
            {
                @Html.ActionLink("Iniciar sesión", "Login", "Acceso", null, new { @class = "vt-btn vt-btn--ghost" })
            }
            else
            {
                <div class="vt-welcome">
                    <i class="bi bi-person-circle"></i>
                    <div>
                        <span>Hola, <strong>@usuario.nombre</strong></span>
                        <small>¡Bienvenido de vuelta! ¿Listo para tu próximo concierto?</small>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="vt-section-label">
        <i class="bi bi-grid-1x2"></i> Módulos del sistema
    </div>

    <div class="vt-grid">

        <article class="vt-card">
            <div class="vt-card__media">
                <i class="bi bi-calendar-event vt-card__media-icon"></i>
            </div>
            <div class="vt-card__body">
                <h2 class="vt-card__title">Eventos</h2>
                <p class="vt-card__type">Explora y gestiona eventos por categoría y venue.</p>
            </div>
            <div class="vt-card__footer">
                <a href="/Eventos" class="vt-btn vt-btn--accent vt-btn--sm">
                    <i class="bi bi-arrow-right"></i> Ver
                </a>
            </div>
        </article>

        <article class="vt-card">
            <div class="vt-card__media">
                <i class="bi bi-mic vt-card__media-icon"></i>
            </div>
            <div class="vt-card__body">
                <h2 class="vt-card__title">Artistas</h2>
                <p class="vt-card__type">Catálogo de artistas y sus presentaciones.</p>
            </div>
            <div class="vt-card__footer">
                <a href="/Artistas" class="vt-btn vt-btn--accent vt-btn--sm">
                    <i class="bi bi-arrow-right"></i> Ver
                </a>
            </div>
        </article>

        <article class="vt-card">
            <div class="vt-card__media">
                <i class="bi bi-building vt-card__media-icon"></i>
            </div>
            <div class="vt-card__body">
                <h2 class="vt-card__title">Venues</h2>
                <p class="vt-card__type">Estadios, teatros y auditorios disponibles.</p>
            </div>
            <div class="vt-card__footer">
                <a href="/Venues" class="vt-btn vt-btn--accent vt-btn--sm">
                    <i class="bi bi-arrow-right"></i> Ver
                </a>
            </div>
        </article>

        <article class="vt-card">
            <div class="vt-card__media">
                <i class="bi bi-ticket-perforated vt-card__media-icon"></i>
            </div>
            <div class="vt-card__body">
                <h2 class="vt-card__title">Tickets</h2>
                <p class="vt-card__type">Compra y administra tus entradas.</p>
            </div>
            <div class="vt-card__footer">
                <a href="/Compras" class="vt-btn vt-btn--accent vt-btn--sm">
                    <i class="bi bi-arrow-right"></i> Ver
                </a>
            </div>
        </article>

        <article class="vt-card">
            <div class="vt-card__media">
                <i class="bi bi-calendar-check vt-card__media-icon"></i>
            </div>
            <div class="vt-card__body">
                <h2 class="vt-card__title">Mi Agenda</h2>
                <p class="vt-card__type">Guarda las presentaciones que no te quieres perder.</p>
            </div>
            <div class="vt-card__footer">
                <a href="/Agenda" class="vt-btn vt-btn--accent vt-btn--sm">
                    <i class="bi bi-arrow-right"></i> Ver
                </a>
            </div>
        </article>

        <article class="vt-card">
            <div class="vt-card__media">
                <i class="bi bi-bell vt-card__media-icon"></i>
            </div>
            <div class="vt-card__body">
                <h2 class="vt-card__title">Notificaciones</h2>
                <p class="vt-card__type">Recordatorios y confirmaciones de compra.</p>
            </div>
            <div class="vt-card__footer">
                <a href="/Notificaciones" class="vt-btn vt-btn--accent vt-btn--sm">
                    <i class="bi bi-arrow-right"></i> Ver
                </a>
            </div>
        </article>

    </div>
</div>