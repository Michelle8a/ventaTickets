@model IEnumerable<GestionTickets.Models.Pago>
@{
    ViewBag.Title = "Historial de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">
            <i class="fa-solid fa-receipt me-2"></i>Historial de Pagos
        </h2>
        @Html.ActionLink("Nuevo Pago", "Create", null,
            new { @class = "btn btn-primary" })
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay pagos registrados aún.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Método</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">Envío</th>
                        <th class="text-end">Propina</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in Model)
                    {
                        <tr>
                            <td>@pago.IdPago</td>
                            <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@pago.Nombre</td>
                            <td>
                                @if (pago.MetodoPago == "card")
                                {
                                    <i class="fa-regular fa-credit-card me-1"></i>
                                    <span>Tarjeta</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                                    <span>Efectivo</span>
                                }
                            </td>
                            <td class="text-end">$@pago.Subtotal.ToString("0.00")</td>
                            <td class="text-end">$@pago.Envio.ToString("0.00")</td>
                            <td class="text-end">$@pago.Propina.ToString("0.00")</td>
                            <td class="text-end fw-bold">$@pago.Total.ToString("0.00")</td>
                            <td>
                                @{
                                    var badge = pago.Estado == "Aprobado" ? "bg-success"
                                              : pago.Estado == "Rechazado" ? "bg-danger"
                                              : "bg-warning text-dark";
                                }
                                <span class="badge @badge">@pago.Estado</span>
                            </td>
                            <td class="text-center">
                                @Html.ActionLink("Ver", "Details",
                                    new { id = pago.IdPago },
                                    new { @class = "btn btn-info btn-sm" })
                                @Html.ActionLink("Editar", "Edit",
                                    new { id = pago.IdPago },
                                    new { @class = "btn btn-warning btn-sm" })
                                @Html.ActionLink("Eliminar", "Delete",
                                    new { id = pago.IdPago },
                                    new { @class = "btn btn-danger btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>