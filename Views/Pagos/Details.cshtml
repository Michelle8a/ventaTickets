@model GestionTickets.Models.Pago
@{
    ViewBag.Title = "Confirmación de Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="card shadow-sm text-center">
                <div class="card-body p-5">

                    <div class="display-4 text-success mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h4 class="mb-1">¡Pedido confirmado!</h4>
                    <p class="text-muted mb-4">
                        Orden&nbsp;<strong>@(ViewBag.CodigoOrden ?? "#" + Model.IdPago.ToString())</strong>
                        &nbsp;·&nbsp;@Model.FechaPago.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <div class="text-start small">

                        <!-- Datos de contacto -->
                        @if (!string.IsNullOrWhiteSpace(Model.Nombre))
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Cliente</div>
                                <div class="col-7 fw-semibold">@Model.Nombre</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Teléfono</div>
                                <div class="col-7">@Model.Telefono</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Direccion))
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Dirección</div>
                                <div class="col-7">@Model.Direccion</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Notas))
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">Notas</div>
                                <div class="col-7">@Model.Notas</div>
                            </div>
                        }

                        <hr />

                        <!-- Método de pago -->
                        <div class="row mb-2">
                            <div class="col-5 text-muted">Método de pago</div>
                            <div class="col-7">
                                @if (Model.Metodo == "card")
                                {
                                    <i class="fa-regular fa-credit-card me-1"></i>
                                    <span>@(ViewBag.TipoTarjeta ?? "Tarjeta")</span>
                                    if (ViewBag.NumeroEnmascarado != null)
                                    {
                                        <span class="text-muted ms-1">@ViewBag.NumeroEnmascarado</span>
                                    }
                                    if (ViewBag.TitularTarjeta != null)
                                    {
                                        <div class="text-muted small">@ViewBag.TitularTarjeta</div>
                                    }
                                }
                                else
                                {
                                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                                    <span>Efectivo</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.StripePaymentIntentId))
                        {
                            <div class="row mb-2">
                                <div class="col-5 text-muted">ID Stripe</div>
                                <div class="col-7 text-break">
                                    <code class="small">@Model.StripePaymentIntentId</code>
                                </div>
                            </div>
                        }

                        <hr />

                        <!-- Totales -->
                        <div class="row mb-1">
                            <div class="col-5 text-muted">Subtotal</div>
                            <div class="col-7">$@Model.Subtotal.ToString("0.00")</div>
                        </div>
                        <div class="row mb-1">
                            <div class="col-5 text-muted">Cargo servicio</div>
                            <div class="col-7">$@Model.Cargos.ToString("0.00")</div>
                        </div>
                        <div class="row mb-1">
                            <div class="col-5 text-muted">Envío</div>
                            <div class="col-7">$@Model.Envio.ToString("0.00")</div>
                        </div>
                        <div class="row fw-bold mt-2">
                            <div class="col-5">Total pagado</div>
                            <div class="col-7 text-success fs-5">$@Model.Monto.ToString("0.00")</div>
                        </div>

                        <!-- Badge de estado -->
                        <div class="text-center mt-3">
                            @{
                                var badge = Model.Estado == "aprobado"    ? "bg-success"
                                          : Model.Estado == "reembolsado" ? "bg-secondary"
                                          : "bg-warning text-dark";
                            }
                            <span class="badge @badge fs-6">@Model.Estado.ToUpper()</span>
                        </div>
                    </div>

                    <!-- Acciones -->
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                        @Html.ActionLink("Ver historial de pagos", "Index", "Pagos",
                            null, new { @class = "btn btn-outline-secondary" })

                        @Html.ActionLink("Volver al inicio", "Index", "Home",
                            null, new { @class = "btn btn-primary" })

                        @if (Model.Estado == "aprobado" && !(bool)(ViewBag.TieneReembolso ?? false))
                        {
                            @Html.ActionLink("Solicitar reembolso", "Create", "Reembolsos",
                                new { pagoId = Model.IdPago },
                                new { @class = "btn btn-outline-danger" })
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
